# =============================================================================
# Configuración de CloudStore E-Commerce (LocalStack + FastAPI + React)
# Copia este archivo a .env si deseas personalizar puertos o credenciales.
# =============================================================================

# AWS / LocalStack
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Opcional para localstack/localstack:3.8; requerido si cambias a localstack/localstack:latest
LOCALSTACK_AUTH_TOKEN=

# Endpoint interno dentro de la red Docker para el backend FastAPI
AWS_ENDPOINT_URL=http://localstack:4566

# Endpoint público usado en URLs de S3 devueltas al navegador (WSL/Host)
S3_PUBLIC_ENDPOINT_URL=http://localhost:4566

# Recursos AWS emulados en LocalStack
S3_AVATARS_BUCKET=user-avatars-bucket
SQS_ORDERS_QUEUE=orders-queue
DYNAMODB_USERS_TABLE=Users
DYNAMODB_PRODUCTS_TABLE=Products
DYNAMODB_ORDERS_TABLE=Orders

# Seguridad JWT del Backend
JWT_SECRET_KEY=localstack-ecommerce-dev-secret-key-2026-change-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# CORS permitido para el Frontend React
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Frontend Vite (build arg)
VITE_API_URL=http://localhost:8000
